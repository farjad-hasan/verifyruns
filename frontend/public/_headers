# Cloudflare Pages headers. The API origin in connect-src is a literal: add the custom domain when it lands.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com https://us-assets.i.posthog.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data:; connect-src 'self' https://verifyruns-api.farjad-developer.workers.dev https://cloudflareinsights.com https://us.i.posthog.com https://us-assets.i.posthog.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: DENY

# Status pages are shareable, not discoverable. The header (not a robots.txt Disallow) is what
# de-indexes: a Disallow would stop crawlers from ever SEEING the noindex, leaving shared links
# indexable URL-only. Crawling one status page costs nothing, and the header needs no JS.
/status/*
  X-Robots-Tag: noindex
